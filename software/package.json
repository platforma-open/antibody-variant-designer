{
  "name": "@platforma-open/milaboratories.antibody-variant-designer.software",
  "version": "1.0.0",
  "description": "Block Software",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "block-tools software build",
    "check": "uv run --group dev ruff check .",
    "deps:export": "bash scripts/deps-export.sh",
    "prepublishOnly": "pl-pkg prepublish"
  },
  "devDependencies": {
    "@platforma-open/milaboratories.runenv-python-3": "catalog:",
    "@platforma-sdk/block-tools": "catalog:",
    "@platforma-sdk/package-builder": "catalog:"
  },
  "block-software": {
    "artifacts": {
      "design-script": {
        "type": "python",
        "registry": "platforma-open",
        "environment": "@platforma-open/milaboratories.runenv-python-3:3.12.10",
        "dependencies": {
          "toolset": "pip",
          "requirements": "requirements.txt"
        },
        "root": "./developability"
      },
      "design-script-with-antifold": {
        "type": "python",
        "registry": "platforma-open",
        "environment": "@platforma-open/milaboratories.runenv-python-3:3.12.10",
        "dependencies": {
          "toolset": "pip",
          "requirements": "requirements-antifold.txt"
        },
        "root": "./developability"
      },
      "design-script-docker": {
        "type": "docker",
        "context": "./developability",
        "dockerfile": "Dockerfile"
      }
    },
    "entrypoints": {
      "index-and-scan": {
        "binary": {
          "artifact": "design-script",
          "cmd": [
            "python",
            "{pkg}/scan.py"
          ]
        },
        "docker": {
          "artifact": "design-script-docker",
          "cmd": [
            "python",
            "{pkg}/scan.py"
          ]
        }
      },
      "read-tolerance": {
        "binary": {
          "artifact": "design-script-with-antifold",
          "cmd": [
            "python",
            "{pkg}/antifold.py"
          ]
        }
      },
      "build-variants": {
        "binary": {
          "artifact": "design-script",
          "cmd": [
            "python",
            "{pkg}/variants.py"
          ]
        },
        "docker": {
          "artifact": "design-script-docker",
          "cmd": [
            "python",
            "{pkg}/variants.py"
          ]
        }
      }
    }
  }
}
