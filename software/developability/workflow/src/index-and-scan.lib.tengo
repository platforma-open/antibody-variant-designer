// The exec recipe for the `index-and-scan` entrypoint — one exec over the
// whole dataset that indexes every staged structure, then scans and triages it.
//
// It ships in the piece that owns the software it runs, so the flag names, the
// workdir paths and the output shape are versioned in the same commit as the
// python that reads and writes them. A caller passes data and gets outputs
// back; it never spells a flag.
//
// It is a package beside the software rather than a library inside it, because
// `block-tools software build` writes the entrypoint descriptor to
// `dist/tengo/software/` while the tengo compiler reads a root package's own
// artifacts from `src/` alone. A library in the software package therefore
// could not resolve its own entrypoint. Here the software is a dependency, and
// a dependency's `dist/tengo` folders are exactly what the compiler reads.

ll := import("@platforma-sdk/workflow-tengo:ll")
assets := import("@platforma-sdk/workflow-tengo:assets")
exec := import("@platforma-sdk/workflow-tengo:exec")
execConstants := import("@platforma-sdk/workflow-tengo:exec.constants")
validation := import("@platforma-sdk/workflow-tengo:validation")

workdir := import(":workdir")

f := exec.formula

scanSw := assets.importSoftware("@platforma-open/milaboratories.antibody-variant-designer.software-developability:index-and-scan")

RESIDUES_DIR := "residues"
TRIAGED_DIR := "triaged"
LIABILITIES_FILE := "liabilities.tsv"
SKIP_FILE := "skip.tsv"

// The two tags the RAM formula measures, because the two are held for different
// lengths of time — see `ramFor`.
STRUCTURE_TAG := "structures"
CONFIDENCE_TAG := "confidence"

// What the process holds before it reads any of the caller's data: the
// interpreter, freesasa, and the liability taxonomy.
BASE_RAM := f.gib(1)

// What one antibody costs, per byte of its PDB text: the parsed `Residue` list,
// plus freesasa's own copy of every atom, which `residue_exposure.py` builds over the
// whole structure rather than over the residues in scope. An upper-bound
// estimate, not a measurement.
RAM_PER_STRUCTURE_BYTE := 32

// What the confidence table costs, per byte of the TSV. Python dicts and floats
// expand it well past its text size, and this multiplier is also an upper-bound
// estimate.
RAM_PER_CONFIDENCE_BYTE := 16

// The most this recipe ever asks for. Both multipliers are deliberately
// generous, so an unusually large input must be able to raise the request
// without pushing it past what a machine running this block has.
RAM_CEILING := f.gib(12)

// What a backend that cannot evaluate a formula at run time gets instead. It is
// also the amount this recipe asked for unconditionally before it could measure.
FALLBACK_RAM := "4GiB"

// Constant where the RAM is not: this is one sequential pass, and nothing in it
// spreads across cores whatever the dataset holds.
DEFAULT_CPU := 2

/**
 * The RAM to ask for, given how many antibodies the staged structures hold.
 *
 * The two terms have different shapes because the two inputs live for different
 * lengths of time. `_load_confidence_tsv` reads the whole table before the loop
 * and holds it to the end, so the confidence term is the TOTAL. `antibody_batch.py` runs
 * one antibody at a time and releases it before the next one starts, so a
 * structure only ever costs the largest one, and the average stands in for it: a
 * tag is measured by its total bytes and the DSL has no maximum, so dividing by
 * the antibody count keeps that term tracking how big one structure is rather
 * than how many of them arrived.
 */
ramFor := func(count) {
	// An empty index would divide by zero, and leaves the base — which is all a
	// run with nothing to scan needs.
	divisor := count > 0 ? count : 1
	return f.size(STRUCTURE_TAG, { default: 0 }).
		dividedBy(divisor).
		times(RAM_PER_STRUCTURE_BYTE).
		plus(f.size(CONFIDENCE_TAG, { default: 0 }).times(RAM_PER_CONFIDENCE_BYTE)).
		plus(BASE_RAM).
		atMost(RAM_CEILING).
		staticFallback(FALLBACK_RAM)
}

// What `run` accepts. Closed on purpose: a caller that misspells `ram` should
// be told, not handed the default in silence.
ARGS := {
	"__options__,closed": "",
	// Sorted-key order, so the exec input stays canonical and a pure step
	// dedups.
	pdbIndex: [{
		"__options__,closed": "",
		clonotypeKey: "string",
		filename: "string"
	}],
	// A `workdir path -> blob` map, as `tpl.inputs()` flattens a staged
	// directory — which is exactly what `addFiles` takes.
	pdbs: { any: validation.resource() },
	definitions: validation.resource(),
	// One dataset-wide TSV, never a directory of per-stem files. Optional
	// because an older upstream emits no per-residue confidence at all, and
	// each antibody then falls back to its own B-factor column.
	"confidence,?": validation.resource(),
	// Absent means the whole index is in scope.
	"clonotypeFilter,?": validation.resource(),
	params: {
		"__options__,closed": "",
		rsasaBuriedCutoff: "number",
		frConfThresh: "number",
		cdrConfThresh: "number",
		actOnFixability: "string"
	},
	// Both optional, and an override wins over the recipe: `ramFor` sizes the RAM
	// and DEFAULT_CPU the cores for whichever dimension the caller leaves out.
	// `ram` arrives already suffixed, `cpu` as a bare count.
	"cpu,?": "number",
	"ram,?": "string"
}

/**
 * Index, scan and triage every antibody in the PDB index.
 *
 * @return {residues: fileSet, triaged: fileSet, liabilities: file,
 *          skip: file, skipContent: content}
 */
run := func(args) {
	validation.assertType(args, ARGS, "index-and-scan: bad args")

	cmd := exec.builder().
		software(scanSw).
		resources({
			queue: execConstants.MEDIUM_QUEUE,
			onCPU: {
				cpu: is_undefined(args.cpu) ? DEFAULT_CPU : args.cpu,
				ram: is_undefined(args.ram) ? ramFor(len(args.pdbIndex)) : args.ram
			}
		}).
		printErrStreamToStdout().
		addFiles(args.pdbs, { tag: STRUCTURE_TAG }).
		writeFile(workdir.INDEX_FILE, workdir.renderIndex(args.pdbIndex)).
		addFile("definitions.json", args.definitions).
		arg("--pdb-dir").arg("pdbs").
		arg("--pdb-index").arg(workdir.INDEX_FILE).
		arg("--definitions").arg("definitions.json").
		arg("--out-residues-dir").arg(RESIDUES_DIR).
		arg("--out-triaged-dir").arg(TRIAGED_DIR).
		arg("--out-liabilities").arg(LIABILITIES_FILE).
		arg("--out-skip").arg(SKIP_FILE).
		arg("--rsasa-buried-cutoff").arg(string(args.params.rsasaBuriedCutoff)).
		arg("--fr-confidence-gating-threshold").arg(string(args.params.frConfThresh)).
		arg("--cdr-confidence-gating-threshold").arg(string(args.params.cdrConfThresh)).
		arg("--act-on-fixability").arg(args.params.actOnFixability)

	// Each optional sidecar's flag is omitted entirely when its input never
	// arrived, rather than passed pointing at an empty file — the python tells
	// "no confidence data" apart from "an empty confidence file" and treats
	// them differently.
	if !is_undefined(args.confidence) {
		cmd = cmd.
			addFile("confidence.tsv", args.confidence, { tag: CONFIDENCE_TAG }).
			arg("--per-residue-confidence").arg("confidence.tsv")
	}
	if !is_undefined(args.clonotypeFilter) {
		cmd = cmd.
			addFile("clonotype_filter.tsv", args.clonotypeFilter).
			arg("--clonotype-filter").arg("clonotype_filter.tsv")
	}

	result := cmd.
		saveFileSet("residues", workdir.dirPattern(RESIDUES_DIR)).
		saveFileSet("triaged", workdir.dirPattern(TRIAGED_DIR)).
		saveFile(LIABILITIES_FILE).
		saveFile(SKIP_FILE).
		saveFileContent(SKIP_FILE).
		run()

	return {
		residues: result.getFileSet("residues"),
		triaged: result.getFileSet("triaged"),
		liabilities: result.getFile(LIABILITIES_FILE),
		skip: result.getFile(SKIP_FILE),
		skipContent: result.getFileContent(SKIP_FILE)
	}
}

export ll.toStrict({
	run: run,
	// Exported for `resources.test.tengo`, which pins what it computes. A caller
	// never needs it: `run` applies it unless the caller overrides `ram`.
	ramFor: ramFor
})
