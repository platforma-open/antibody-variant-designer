{
  "name": "@platforma-open/milaboratories.antibody-variant-designer.software-developability",
  "version": "1.0.0",
  "description": "Residue indexing, liability scan and triage, candidate generation and ranking",
  "files": [
    "./dist/**/*"
  ],
  "type": "module",
  "scripts": {
    "build": "block-tools software build",
    "deps:export": "bash scripts/deps-export.sh",
    "do-pack": "shx rm -f *.tgz && block-tools software build && pnpm pack && shx mv platforma-open*.tgz package.tgz",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@platforma-open/milaboratories.runenv-python-3": "catalog:",
    "@platforma-sdk/block-tools": "catalog:"
  },
  "block-software": {
    "artifacts": {
      "developability": {
        "type": "python",
        "registry": "platforma-open",
        "environment": "@platforma-open/milaboratories.runenv-python-3:3.12.10",
        "dependencies": {
          "toolset": "pip",
          "requirements": "requirements.txt"
        },
        "root": "./src"
      },
      "developability-docker": {
        "type": "docker",
        "context": "./src",
        "dockerfile": "Dockerfile"
      }
    },
    "entrypoints": {
      "index-and-scan": {
        "binary": {
          "artifact": "developability",
          "cmd": [
            "python",
            "{pkg}/index_and_scan.py"
          ]
        },
        "docker": {
          "artifact": "developability-docker",
          "cmd": [
            "python",
            "{pkg}/index_and_scan.py"
          ]
        }
      },
      "build-variants": {
        "binary": {
          "artifact": "developability",
          "cmd": [
            "python",
            "{pkg}/build_variants.py"
          ]
        },
        "docker": {
          "artifact": "developability-docker",
          "cmd": [
            "python",
            "{pkg}/build_variants.py"
          ]
        }
      }
    }
  }
}
