// Copy every blob of a step's fileSet into primary storage, as soon as the
// step that produced it is done.
//
// A step output lands in `work` storage, and the only thing holding those bytes
// there is a cache pin the storage controller puts on the blob index when it
// registers the file — one minute, by the server's own default. Holding a
// reference does not extend it: the `Blob` resource for a work-produced file is
// created with no incarnation attached, on purpose, so that an active storage's
// lifecycle and the blob's identity stay separate. A workflow can therefore hold
// the identity of a file it produced and still have nothing behind it.
//
// The durable copy is normally made by the consumer, when its exec fills its
// workdir — which cannot happen before that exec has a compute allocation. A
// step that queues for a GPU asks minutes after the file was written, long after
// the pin lapsed, and gets "lost blob ... no incarnations found in any of
// storages" for a file that was written correctly.
//
// `file.exportFile` reaches the same copy by the other route: it builds a blob
// download request, which the data controller acts on the moment its input
// resolves — no allocation, no consumer, nothing queued ahead of it. Rendering
// this as soon as the fileSet locks puts the bytes in primary within seconds of
// the step that made them, and primary is where they stay.
//
// Ephemeral because the keys are the step's own output paths: they exist only
// once the producing exec has run.

tpl := import("@platforma-sdk/workflow-tengo:tpl.light")

file := import("@platforma-sdk/workflow-tengo:file")
smart := import("@platforma-sdk/workflow-tengo:smart")

// The set of paths is the step's, not the caller's, so the body waits for the
// producing exec to fix it rather than for any one file to arrive.
tpl.awaitState("fileSet", "InputsLocked")

// Read through the raw field rather than `inputs`, which unmarshals a map
// resource into a plain tengo map and panics as soon as one entry carries an
// error (`tpl.base:52-71`). This template exists to make a step's output
// survivable; it must not become a second place the run can die.
tpl.body(func(inputs) {
	copies := {}
	for path, blob in tpl.rawInputs().fileSet.getValue().inputs() {
		copies[path] = file.exportFile(blob)
	}

	// Returned so the copies stay referenced for as long as the caller keeps
	// this output. Nothing reads the map itself.
	return { copies: smart.createMapResource(copies) }
})
