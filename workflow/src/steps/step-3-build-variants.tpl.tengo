// Step 3 of 3 — build candidate substitutions, re-scan each, rank what
// survives.
//
// The re-scan is the block's only real filter; the ranking discards nothing.
// They share this one exec because ranking reads nothing the gate did not
// just produce, so a boundary between them would buy no parallelism and no
// independent attribution while costing a job bootstrap and a directory of
// candidate files written out and staged back in.
//
// `variants.tsv` is dataset-wide and leaves the pipeline as a PFrame. Its
// `variantKey` is content-addressed over the parent, the block and the edit
// set, which is why the block id has to reach the process that writes it.

self := import("@platforma-sdk/workflow-tengo:tpl")

assets := import("@platforma-sdk/workflow-tengo:assets")
exec := import("@platforma-sdk/workflow-tengo:exec")

validation := import("@platforma-sdk/workflow-tengo:validation")

workdir := import(":steps.workdir")

variantsSw := assets.importSoftware("@platforma-open/milaboratories.antibody-variant-designer.software:build-variants")

VARIANTS_FILE := "variants.tsv"
SKIP_FILE := "skip.tsv"

self.validateInputs({
	"__options__,closed": "",
	// The roster, verbatim as `main.tpl.tengo` built it from the PDB
	// ResourceMap's sorted keys.
	roster: [{
		"__options__,closed": "",
		clonotypeKey: "string",
		filename: "string"
	}],
	triaged: { any: validation.resource() },
	tolerance: { any: validation.resource() },
	residues: { any: validation.resource() },
	definitions: validation.resource(),
	// The third ingredient of the variantKey hash, alongside the parent key
	// and the edit set.
	blockId: "string",
	params: {
		"__options__,closed": "",
		maxEditsPerVariant: "number",
		candidateResiduesPerPosition: "number",
		variantsPerParent: "number",
		lowToleranceFloor: "number",
		epistasisRescoreTopK: "number"
	}
})

self.defineOutputs("variants", "skip", "skipContent")

self.body(func(inputs) {
	result := exec.builder().
		software(variantsSw).
		resources({ queue: "medium", onCPU: { cpu: 2, ram: "4GiB" } }).
		printErrStreamToStdout().
		addFiles(inputs.triaged).
		addFiles(inputs.tolerance).
		addFiles(inputs.residues).
		writeFile(workdir.INDEX_FILE, workdir.renderIndex(inputs.roster)).
		addFile("definitions.json", inputs.definitions).
		arg("--pdb-index").arg(workdir.INDEX_FILE).
		arg("--triaged-dir").arg("triaged").
		arg("--tolerance-dir").arg("tolerance").
		arg("--residues-dir").arg("residues").
		arg("--definitions").arg("definitions.json").
		arg("--block-id").arg(inputs.blockId).
		arg("--out-variants").arg(VARIANTS_FILE).
		arg("--out-skip").arg(SKIP_FILE).
		arg("--max-edits-per-variant").arg(string(inputs.params.maxEditsPerVariant)).
		arg("--candidate-residues-per-position").
		arg(string(inputs.params.candidateResiduesPerPosition)).
		arg("--variants-per-parent").arg(string(inputs.params.variantsPerParent)).
		arg("--low-tolerance-floor").arg(string(inputs.params.lowToleranceFloor)).
		arg("--epistasis-rescore-top-k").arg(string(inputs.params.epistasisRescoreTopK)).
		saveFile(VARIANTS_FILE).
		saveFile(SKIP_FILE).
		saveFileContent(SKIP_FILE).
		run()

	return {
		variants: result.getFile(VARIANTS_FILE),
		skip: result.getFile(SKIP_FILE),
		skipContent: result.getFileContent(SKIP_FILE)
	}
})
