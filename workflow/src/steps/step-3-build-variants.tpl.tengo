// Step 3 of 3 — build candidate substitutions, re-scan each, rank what
// survives.
//
// The re-scan is the block's only real filter; the ranking discards nothing.
// They share this one exec because ranking reads nothing the gate did not
// just produce, so a boundary between them would buy no parallelism and no
// independent attribution while costing a job bootstrap and a directory of
// candidate files written out and staged back in.
//
// `variants.tsv` is dataset-wide and leaves the pipeline as a PFrame. Its
// `variantKey` is a per-parent ordinal — `v01`, `v02`, … in that parent's own
// local rank order — so no block id reaches this process: run identity lands
// on the emitted columns as a spec domain after the exec, which is what lets
// two blocks over one dataset share this run. `rank` itself is not per-parent
// any more — the process rewrites it to a dataset-wide ordinal once the whole
// batch loop is done ([[088-decision-rank-becomes-a-global-ordinal-via-a-second-pass]]).
// `parentRank` carries the value `rank` used to: a per-parent-only ordinal,
// for the Variants page alone — no `csvHeader`, so the vendor's CSV never
// sees it.
//
// The exec recipe itself — flag names, workdir paths, output shape, resource
// sizing — lives in the software package that owns the entrypoint. What
// stays here is the block's side of the contract: which inputs are valid, what
// the step is named to produce, and how an Advanced Settings override reaches
// the recipe.

self := import("@platforma-sdk/workflow-tengo:tpl")

validation := import("@platforma-sdk/workflow-tengo:validation")

buildVariants := import("@platforma-open/milaboratories.antibody-variant-designer.software-developability.workflow:build-variants")

self.validateInputs({
	"__options__,closed": "",
	triaged: validation.resource(),
	tolerance: validation.resource(),
	priors: { any: validation.resource() },
	residues: validation.resource(),
	definitions: validation.resource(),
	// The parents step 1 staged. An upper bound on the parents this step
	// reads, because step 1 rejects some — see `ramFor`.
	parentCount: "number",
	params: {
		"__options__,closed": "",
		runMode: "string",
		maxLiabilityEdits: "number",
		maxFrameworkEdits: "number",
		candidateResiduesPerPosition: "number",
		structuralWeight: "number",
		objectiveWeight: "number",
		nonHumanPriorMargin: "number",
		maxNewLiabilities: "number",
		humanizationIgnoredLiabilities: "string",
		frConfidenceThreshold: "number",
		variantsPerParent: "number",
		lowToleranceFloor: "number",
		epistasisRescoreTopK: "number"
	},
	// Advanced Settings → Resource Allocation. Either may be unset — the recipe
	// sizes the dimension the operator left empty from the data it is handed.
	resources: {
		"__options__,closed": "",
		"cpu,?": "number",
		"mem,?": "number"
	}
})

self.defineOutputs(
	"variants", "humanness", "parentSequences", "rejected", "rejectedContent")

// `parentCount` joins the inputs the body forwards wholesale.
self.body(func(inputs) {
	return buildVariants.run({
		triaged: inputs.triaged,
		tolerance: inputs.tolerance,
		priors: inputs.priors,
		residues: inputs.residues,
		definitions: inputs.definitions,
		parentCount: inputs.parentCount,
		params: inputs.params,
		cpu: inputs.resources.cpu,
		ram: is_undefined(inputs.resources.mem) ? undefined : string(inputs.resources.mem) + "GiB"
	})
})
