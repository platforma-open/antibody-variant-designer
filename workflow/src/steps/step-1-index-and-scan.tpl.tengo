// Step 1 of 3 — index every staged structure, then scan and triage it.
//
// One exec over the whole dataset. The residue index and the scan share one
// deployment unit and nothing between them is read by anything else, so they
// are one process: the entrypoint's index phase produces the index and its
// scan phase consumes it in memory.
//
// Two outputs cross a boundary as directories — the residue index, read by
// both later steps, and the triaged liabilities, read by the last one. Each
// holds a file only for the antibodies that got that far; absence is how a
// later step learns an antibody was already named. `liabilities.tsv` is
// dataset-wide and leaves the pipeline as a PFrame, not as a step input.

self := import("@platforma-sdk/workflow-tengo:tpl")

assets := import("@platforma-sdk/workflow-tengo:assets")
exec := import("@platforma-sdk/workflow-tengo:exec")

validation := import("@platforma-sdk/workflow-tengo:validation")

workdir := import(":steps.workdir")

scanSw := assets.importSoftware("@platforma-open/milaboratories.antibody-variant-designer.software:index-and-scan")

RESIDUES_DIR := "residues"
TRIAGED_DIR := "triaged"
LIABILITIES_FILE := "liabilities.tsv"
SKIP_FILE := "skip.tsv"

self.validateInputs({
	"__options__,closed": "",
	// The roster, verbatim as `main.tpl.tengo` built it from the PDB
	// ResourceMap's sorted keys.
	roster: [{
		"__options__,closed": "",
		clonotypeKey: "string",
		filename: "string"
	}],
	// Each staged directory arrives flattened by `tpl.inputs()` — a
	// `workdir path -> blob` map, which is exactly what `addFiles` takes.
	pdbs: { any: validation.resource() },
	// Optional: one dataset-wide TSV each, never a directory of per-stem
	// files. An older upstream emits no per-residue confidence at all, and
	// each antibody then falls back to its own B-factor column; an absent
	// filter means the whole roster is in scope.
	"confidence,?": validation.resource(),
	"clonotypeFilter,?": validation.resource(),
	definitions: validation.resource(),
	params: {
		"__options__,closed": "",
		rsasaBuriedCutoff: "number",
		frConfThresh: "number",
		cdrConfThresh: "number",
		actOnFixability: "string"
	}
})

self.defineOutputs("residues", "triaged", "liabilities", "skip", "skipContent")

self.body(func(inputs) {
	// `pdbs` arrives already flattened by `tpl.inputs()`: a `path -> blob`
	// map whose keys are the workdir paths the producer used, so
	// `addFiles` restages it verbatim.
	cmd := exec.builder().
		software(scanSw).
		resources({ queue: "medium", onCPU: { cpu: 2, ram: "4GiB" } }).
		printErrStreamToStdout().
		addFiles(inputs.pdbs).
		writeFile(workdir.INDEX_FILE, workdir.renderIndex(inputs.roster)).
		addFile("definitions.json", inputs.definitions).
		arg("--pdb-dir").arg("pdbs").
		arg("--pdb-index").arg(workdir.INDEX_FILE).
		arg("--definitions").arg("definitions.json").
		arg("--out-residues-dir").arg(RESIDUES_DIR).
		arg("--out-triaged-dir").arg(TRIAGED_DIR).
		arg("--out-liabilities").arg(LIABILITIES_FILE).
		arg("--out-skip").arg(SKIP_FILE).
		arg("--rsasa-buried-cutoff").arg(string(inputs.params.rsasaBuriedCutoff)).
		arg("--fr-confidence-gating-threshold").arg(string(inputs.params.frConfThresh)).
		arg("--cdr-confidence-gating-threshold").arg(string(inputs.params.cdrConfThresh)).
		arg("--act-on-fixability").arg(inputs.params.actOnFixability)

	// Both sidecars are optional dataset-wide TSVs, not directories: an
	// older upstream emits no per-residue confidence at all, and an absent
	// filter means the whole roster is in scope. Each flag is omitted
	// entirely when its input never arrived, rather than passed pointing at
	// an empty file.
	if !is_undefined(inputs.confidence) {
		cmd = cmd.
			addFile("confidence.tsv", inputs.confidence).
			arg("--per-residue-confidence").arg("confidence.tsv")
	}
	if !is_undefined(inputs.clonotypeFilter) {
		cmd = cmd.
			addFile("clonotype_filter.tsv", inputs.clonotypeFilter).
			arg("--clonotype-filter").arg("clonotype_filter.tsv")
	}

	result := cmd.
		saveFileSet("residues", workdir.dirPattern(RESIDUES_DIR)).
		saveFileSet("triaged", workdir.dirPattern(TRIAGED_DIR)).
		saveFile(LIABILITIES_FILE).
		saveFile(SKIP_FILE).
		saveFileContent(SKIP_FILE).
		run()

	return {
		residues: result.getFileSet("residues"),
		triaged: result.getFileSet("triaged"),
		liabilities: result.getFile(LIABILITIES_FILE),
		skip: result.getFile(SKIP_FILE),
		skipContent: result.getFileContent(SKIP_FILE)
	}
})
