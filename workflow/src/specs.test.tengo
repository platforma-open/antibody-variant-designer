// The emitted PColumn specs are a contract with every downstream block and
// with the synthesis vendor, and nothing else in the build checks a spec
// string. These cases pin the parts a rename would break silently: each
// group's axis names, one column name per group, the identity columns that
// carry the parent binding, the blockId context domain on every column, and
// the CSV's full vendor header set.

test := import("@platforma-sdk/workflow-tengo:test")
specs := import(":specs")

BLOCK_ID := "block-under-test"

CLONOTYPE_AXIS := {
	type: "String",
	name: "pl7.app/vdj/scClonotypeKey",
	annotations: { "pl7.app/label": "Clonotype" }
}

// Keyed by the TSV header, which is also the key the importer gives each
// column in the resulting PFrame map.
_byColumn := func(columns) {
	out := {}
	for c in columns {
		out[c.column] = c
	}
	return out
}

TestVariantAxes := func() {
	settings := specs.buildVariantsSettings(BLOCK_ID)

	// One axis, the variant's own key — the parent rides along as binding
	// columns.
	test.isEqual(1, len(settings.axes))
	test.isEqual("variantClonotypeKey", settings.axes[0].column)
	test.isEqual("String", settings.axes[0].spec.type)

	// The registry's variant identity axis, so every block that already reads
	// variants can read this group. Never `pl7.app/vdj/clonotypeKey`: label
	// discovery binds a label column to an axis by axis name alone, so that
	// name would pull the PARENT's label onto this axis.
	test.isEqual("pl7.app/variantKey", settings.axes[0].spec.name)

	// That name has several producers, and exactly one domain key tells them
	// apart — a peptide run writes `pl7.app/peptide/extractionRunId`, an
	// amplicon run `pl7.app/repertoire/extractionRunId`, a design run writes
	// this one. It carries the block id because two runs hash the same designed
	// sequence to the same value, so only the domain keeps their rows apart.
	test.isEqual(1, len(settings.axes[0].spec.domain))
	test.isEqual(BLOCK_ID, settings.axes[0].spec.domain["pl7.app/antibodyVariantDesigner/designRunId"])
}

TestVariantColumns := func() {
	settings := specs.buildVariantsSettings(BLOCK_ID)
	byColumn := _byColumn(settings.columns)

	// Fifteen value columns on one axis: the vendor's twelve less `variantId`,
	// which the vendor's CSV carries and no table does, then the four identity
	// columns that carry what the axes used to — the variant's own clonotype id,
	// the parent binding in both spellings, and the ordinal.
	test.isEqual(15, len(settings.columns))
	for c in settings.columns {
		test.isTrue(c.column != "variantId")
	}

	// The variant's readable id is spelled `pl7.app/label`, so it labels this
	// group's axis for every table and every downstream consumer.
	test.isEqual("pl7.app/label", byColumn.variantClonotypeId.spec.name)
	test.isEqual("pl7.app/antibodyVariantDesigner/parentClonotypeId", byColumn.parentClonotypeId.spec.name)
	test.isEqual(
		"pl7.app/antibodyVariantDesigner/parentClonotypeKey",
		byColumn.parentClonotypeKey.spec.name)
	test.isEqual("pl7.app/antibodyVariantDesigner/variantKey", byColumn.variantKey.spec.name)

	// The designed sequence reuses the sequence name every consumer reads,
	// qualified by feature and alphabet rather than renamed.
	test.isEqual("pl7.app/vdj/sequence", byColumn.variantSequence.spec.name)
	test.isEqual("VDJRegion", byColumn.variantSequence.spec.domain["pl7.app/vdj/feature"])
	test.isEqual("aminoacid", byColumn.variantSequence.spec.domain["pl7.app/alphabet"])

	// The one column with a `domain`, and it holds only the two keys sequence
	// consumers match on — never the block id.
	test.isEqual(2, len(byColumn.variantSequence.spec.domain))
	for c in specs.buildVariantsSettings(BLOCK_ID).columns {
		if c.column != "variantSequence" {
			test.isTrue(is_undefined(c.spec.domain))
		}
	}

	test.isEqual("pl7.app/score", byColumn.rank.spec.name)
	test.isEqual("Long", byColumn.rank.spec.valueType)
	test.isEqual("increasing", byColumn.rank.spec.annotations["pl7.app/score/rankingOrder"])

	test.isEqual("pl7.app/liabilities/addressedTarget", byColumn.addressedTarget.spec.name)
	test.isEqual("pl7.app/liabilities/changedPositions", byColumn.changedPositions.spec.name)
	test.isEqual("pl7.app/vdj/bindingRisk", byColumn.bindingRisk.spec.name)

	// Both are JSON text, spelled once. Building them with `json.encode`
	// would put a Go map iteration order inside a rendered template input.
	test.isEqual("[\"Low\",\"Medium\",\"High\"]",
		byColumn.bindingRisk.spec.annotations["pl7.app/discreteValues"])
	test.isEqual("[\"Low\",\"Medium\"]",
		byColumn.bindingRisk.spec.annotations["pl7.app/score/defaultCutoff"])

	test.isEqual("pl7.app/liabilities/lowConfidence", byColumn.lowConfidenceWarning.spec.name)
	test.isEqual("pl7.app/antibodyVariantDesigner/status", byColumn.status.spec.name)

	test.isEqual("pl7.app/antibodyVariantDesigner/chain", byColumn.chain.spec.name)
	test.isEqual("pl7.app/antibodyVariantDesigner/objective", byColumn.objective.spec.name)

	// Both metrics declare their scale, because both are backend-specific and
	// a consumer cannot infer either from the number.
	test.isEqual("antifoldPerplexityBits",
		byColumn.structuralTolerance.spec.annotations["pl7.app/structure/toleranceMetric"])
	test.isEqual("predictedErrorAngstroms",
		byColumn.worstConfidence.spec.annotations["pl7.app/structure/confidenceMetric"])

	// Hidden is not absent: both stay in the data and in the CSV.
	test.isEqual("hidden", byColumn.variantSequence.spec.annotations["pl7.app/table/visibility"])
	test.isEqual("hidden", byColumn.status.spec.annotations["pl7.app/table/visibility"])

	// The row's identity leads the table: the variant's own id first, because a
	// `pl7.app/label` column sorts ahead of every value column, then the parent
	// it was designed from, then the parent's key.
	test.isEqual("variantClonotypeId", settings.columns[0].column)
	test.isEqual("parentClonotypeId", settings.columns[1].column)
	test.isEqual("parentClonotypeKey", settings.columns[2].column)

	// The readable parent stays on screen; only its hash is switchable.
	test.isTrue(
		is_undefined(byColumn.parentClonotypeId.spec.annotations["pl7.app/table/visibility"]))
	test.isEqual("optional",
		byColumn.parentClonotypeKey.spec.annotations["pl7.app/table/visibility"])
}

TestParentsGroup := func() {
	settings := specs.buildParentsSettings(BLOCK_ID, CLONOTYPE_AXIS)
	byColumn := _byColumn(settings.columns)

	// One axis, the parent alone.
	// [[082-decision-the-liabilities-group-drops-to-one-axis]] dropped the
	// second (liability) axis: a parent's several triaged liabilities,
	// declined ones included, now collapse into one row.
	test.isEqual(1, len(settings.axes))
	test.isEqual("pl7.app/vdj/scClonotypeKey", settings.axes[0].spec.name)

	test.isEqual(3, len(settings.columns))
	test.isEqual("pl7.app/liabilities/verdict", byColumn.verdict.spec.name)
	test.isEqual("pl7.app/liabilities/summary", byColumn.summary.spec.name)
	test.isEqual("String", byColumn.verdict.spec.valueType)
	test.isEqual("String", byColumn.summary.spec.valueType)
	test.isEqual("true", byColumn.verdict.spec.annotations["pl7.app/isDiscreteFilter"])

	// The parent's readable name stands in for the axis, and is NOT spelled
	// `pl7.app/label`: upstream already emits that name for this axis, and the
	// model-side table renderer cannot reach it through the result pool.
	test.isEqual(
		"pl7.app/antibodyVariantDesigner/parentClonotypeId", byColumn.parentClonotypeId.spec.name)
	test.isEqual("Parent Clonotype Id", byColumn.parentClonotypeId.spec.annotations["pl7.app/label"])

	// So the axis carrying the hash is hidden — one parent, one column. It is
	// hidden through a copy: the caller hands the same spec to the variant
	// group's parent binding, so a write into it would hide that too.
	test.isEqual("hidden", settings.axes[0].spec.annotations["pl7.app/table/visibility"])
	test.isTrue(is_undefined(CLONOTYPE_AXIS.annotations["pl7.app/table/visibility"]))

	// The parent leads, then Verdict, then Summary — the list order.
	test.isEqual("parentClonotypeId", settings.columns[0].column)
	test.isEqual("verdict", settings.columns[1].column)
	test.isEqual("summary", settings.columns[2].column)
}

TestEveryColumnCarriesTheBlockId := func() {
	both := append(
		specs.buildVariantsSettings(BLOCK_ID).columns,
		specs.buildParentsSettings(BLOCK_ID, CLONOTYPE_AXIS).columns...)

	// Reusing a shared segment is only safe because of this key: two blocks
	// emit `pl7.app/liabilities/lowConfidence` and the block id keeps them
	// apart. It sits in `contextDomain`, matched by kinship, so a consumer that
	// never heard of this block can still select the column — an exact-match
	// `domain` key would demand it know this run.
	for c in both {
		test.isEqual(BLOCK_ID, c.spec.contextDomain["pl7.app/blockId"])
		test.isTrue(is_undefined(c.spec.domain) ||
			is_undefined(c.spec.domain["pl7.app/blockId"]))
	}
}

TestNoValueTypeIsBooleanOrObject := func() {
	both := append(
		specs.buildVariantsSettings(BLOCK_ID).columns,
		specs.buildParentsSettings(BLOCK_ID, CLONOTYPE_AXIS).columns...)

	// Booleans travel as "yes"/"no" strings and no column carries JSON.
	for c in both {
		test.isTrue(c.spec.valueType == "String" ||
			c.spec.valueType == "Double" ||
			c.spec.valueType == "Long")
	}
}

TestEveryAxisAndColumnIsDescribed := func() {
	// A spec a reader meets on screen and a spec a downstream block selects on
	// are the same spec, and the description is the only place either learns
	// what a value means — the label names it, the description says what it is.
	// So both groups carry one on every axis and on every column, including the
	// hidden parent axis, which a downstream consumer still reads.
	variants := specs.buildVariantsSettings(BLOCK_ID)
	parents := specs.buildParentsSettings(BLOCK_ID, CLONOTYPE_AXIS)

	for a in append(variants.axes, parents.axes...) {
		test.isTrue(!is_undefined(a.spec.annotations["pl7.app/description"]))
	}
	for c in append(variants.columns, parents.columns...) {
		test.isTrue(!is_undefined(c.spec.annotations["pl7.app/label"]))
		test.isTrue(!is_undefined(c.spec.annotations["pl7.app/description"]))
	}
}

TestSynthesisCsvColumnOrder := func() {
	// Built off the flat table in `main.tpl.tengo`, not re-specced PColumn
	// data — a PColumn's `axesSpec` must match its data's physical partition
	// count, which re-speccing to fewer axes violates at *read* time, not at
	// spec-build time. This function just names which flat column feeds which
	// CSV header, in the vendor's own order — `main.tpl.tengo` does the
	// `pt.col(...).alias(...)` selection.
	order := specs.csvColumnOrder(BLOCK_ID)

	// Twelve of the sixteen variant columns declare a `csvHeader` — the full
	// vendor set, which does not include `humannessScore`. The four identity
	// columns declare none, so the table can reorder around them without the
	// vendor's set changing.
	test.isEqual(12, len(order))

	headers := []
	columns := []
	for c in order {
		headers = append(headers, c.csvHeader)
		columns = append(columns, c.column)
	}
	test.isEqual([
		"variantId", "rank", "variantSequence", "chain", "changedPositions",
		"objective", "addressedTarget", "structuralTolerance", "worstConfidence",
		"bindingRisk", "lowConfidenceWarning", "status"
	], headers)
	// Every header here equals its flat column name — no CSV spelling drifts
	// from the TSV column `variant_store.py` writes.
	test.isEqual(headers, columns)
}

TestOrderPriorityFollowsListPosition := func() {
	// The list is the table order, so the priority is stamped from the position
	// and no spec writes a number of its own. A column that gained a hand-written
	// priority would be overwritten here, not honoured — this is what says so.
	variants := specs.buildVariantsSettings(BLOCK_ID)
	parents := specs.buildParentsSettings(BLOCK_ID, CLONOTYPE_AXIS)

	for settings in [variants, parents] {
		previous := undefined
		for c in settings.columns {
			priority := c.spec.annotations["pl7.app/table/orderPriority"]
			test.isTrue(!is_undefined(priority))
			if !is_undefined(previous) {
				// The grid draws a higher priority first, so a later row must
				// carry a smaller number than the row above it.
				test.isTrue(int(priority) < int(previous))
			}
			previous = priority
		}
	}

	// The first column of each group takes one step per column, the last takes
	// one step.
	test.isEqual("15000", variants.columns[0].spec.annotations["pl7.app/table/orderPriority"])
	test.isEqual("1000", variants.columns[14].spec.annotations["pl7.app/table/orderPriority"])
	test.isEqual("3000", parents.columns[0].spec.annotations["pl7.app/table/orderPriority"])
	test.isEqual("1000", parents.columns[2].spec.annotations["pl7.app/table/orderPriority"])
}
