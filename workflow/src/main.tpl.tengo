// Antibody Variant Designer, workflow entry point.
//
// Resolves the structures dataset (and its optional Lead Selection subset),
// stages every PDB blob into the roster the three steps share, runs the
// shared liability taxonomy once, wires `index-and-scan` -> `read-tolerance`
// -> `build-variants`, and imports the two dataset-wide TSVs the last two
// steps leave behind as PFrames. No per-residue logic and no step body live
// here — that is entirely the steps' concern.

wf := import("@platforma-sdk/workflow-tengo:workflow")
assets := import("@platforma-sdk/workflow-tengo:assets")
exec := import("@platforma-sdk/workflow-tengo:exec")
render := import("@platforma-sdk/workflow-tengo:render")
file := import("@platforma-sdk/workflow-tengo:file")
ll := import("@platforma-sdk/workflow-tengo:ll")
maps := import("@platforma-sdk/workflow-tengo:maps")
pframes := import("@platforma-sdk/workflow-tengo:pframes")
pSpec := import("@platforma-sdk/workflow-tengo:pframes.spec")
xsv := import("@platforma-sdk/workflow-tengo:pframes.xsv")
pt := import("@platforma-sdk/workflow-tengo:pt")
text := import("text")
json := import("json")

specs := import(":specs")

definitionsSw := assets.importSoftware("@platforma-open/milaboratories.software-liability-definitions:main")

Step1ScanLiabilitiesTpl := assets.importTemplate(":steps.step-1-index-and-scan")
Step2ReadToleranceTpl := assets.importTemplate(":steps.step-2-read-tolerance")
Step3BuildVariantsTpl := assets.importTemplate(":steps.step-3-build-variants")

/**
 * Residues, triaged sites, and the parent-keyed liabilities TSV — including
 * declined liabilities the Parents page needs.
 * Optional confidence / subset sidecars are single dataset-wide TSVs.
 */
ScanLiabilities := func(roster, pdbs, definitions, args, columns, resolvedSubset) {
	inputs := {
		roster: roster,
		pdbs: pdbs,
		definitions: definitions,
		params: {
			rsasaBuriedCutoff: args.rsasaBuriedCutoff,
			frConfThresh: args.frConfThresh,
			cdrConfThresh: args.cdrConfThresh,
			actOnFixability: text.join(args.actOnFixability, ",")
		},
		// Advanced Settings → Resource Allocation. Either may be unset; the
		// step keeps its own fixed default for the dimension the operator
		// left empty.
		resources: {
			cpu: args.indexAndScanCpu,
			mem: args.indexAndScanMem
		}
	}

	confidenceCols := columns.getColumns("perResidueConfidence")
	if !is_undefined(confidenceCols) && len(confidenceCols) > 0 {
		inputs.confidence = xsv.exportFrame([confidenceCols[0]], "tsv", { mem: "1GiB", cpu: 1 })
	}

	// The optional Lead Selection subset scopes this step alone; later steps
	// already narrow via absent predecessor artifacts, so exporting the
	// same key list twice would buy nothing.
	if !is_undefined(resolvedSubset) {
		inputs.clonotypeFilter = xsv.exportFrame([resolvedSubset], "tsv", { mem: "1GiB", cpu: 1 })
	}

	return render.create(Step1ScanLiabilitiesTpl, inputs)
}

/**
 * Per-position structural tolerance for every antibody that still has work.
 */
_readTolerance := func(roster, pdbs, residues, triaged, args) {
	return render.create(Step2ReadToleranceTpl, {
		roster: roster,
		pdbs: pdbs,
		residues: residues,
		triaged: triaged,
		resources: {
			cpu: args.readToleranceCpu,
			mem: args.readToleranceMem
		}
	})
}

/**
 * Ranked variant hypotheses that cleared the re-scan gate.
 */
_buildVariants := func(roster, triaged, tolerance, residues, definitions, blockId, args) {
	return render.create(Step3BuildVariantsTpl, {
		roster: roster,
		triaged: triaged,
		tolerance: tolerance,
		residues: residues,
		definitions: definitions,
		blockId: blockId,
		params: {
			maxEditsPerVariant: args.maxEditsPerVariant,
			candidateResiduesPerPosition: args.candidateResiduesPerPosition,
			variantsPerParent: args.variantsPerParent,
			lowToleranceFloor: args.lowToleranceFloor,
			epistasisRescoreTopK: args.epistasisRescoreTopK
		},
		resources: {
			cpu: args.buildVariantsCpu,
			mem: args.buildVariantsMem
		}
	})
}

/**
 * `C-XXXXX` from a clonotype key, by upstream's own recipe — digits dropped,
 * first five characters, uppercased, with a `-N` suffix when two keys in the
 * frame share that prefix
 * (`mixcr-clonotyping/workflow/src/clonotype-label.lib.tengo:87-115`). Copied
 * rather than imported: the lib lives in another block's repo, and matching
 * upstream's spelling exactly is the whole point.
 *
 * Returns the frame with `outCol` added; the two working columns are dropped
 * again before it returns.
 */
_withDerivedCloneId := func(df, keyCol, outCol) {
	prefixCol := outCol + "_prefix_tmp"
	rankCol := outCol + "_rank_tmp"

	df = df.withColumns(
		pt.col(keyCol).
			strReplace("\\d", "", { replaceAll: true }).
			strSlice(0, 5).
			strToUpper().
			alias(prefixCol))
	df = df.withColumns(
		pt.rank(pt.col(keyCol)).over(pt.col(prefixCol)).alias(rankCol))
	df = df.withColumns(
		pt.when(pt.col(rankCol).gt(pt.lit(1))).
			then(pt.concatStr(
				[pt.lit("C"), pt.col(prefixCol), pt.col(rankCol).cast("String")],
				{ delimiter: "-" })).
			otherwise(pt.concatStr([pt.lit("C"), pt.col(prefixCol)], { delimiter: "-" })).
			alias(outCol))

	return df.withoutColumns(prefixCol, rankCol)
}

/**
 * `parentCloneId` beside every row's `clonotypeKey` — upstream's own label
 * when the dataset carries one, derived from the key when it does not. Both
 * flat tables gain the column through this one function, so the Variants page
 * and the Parents page always name one parent alike.
 *
 * A left join: a parent the label frame does not mention keeps its rows with
 * an empty cell, rather than losing a designed variant or a liability.
 *
 * The derived branch runs on the DISTINCT key set and joins the result back,
 * never on the table itself. `_withDerivedCloneId` ranks a key inside its
 * prefix group, and both tables hold several rows per parent — every variant
 * of one parent, every liability of one antibody — so a repeated key would
 * rank above 1 and take a `-N` suffix it has not earned.
 */
_withParentCloneId := func(ptWf, df, parentLabels) {
	ids := undefined
	if is_undefined(parentLabels) {
		ids = _withDerivedCloneId(
			df.select(pt.col("clonotypeKey")).unique({ subset: "clonotypeKey" }),
			"clonotypeKey",
			"parentCloneId")
	} else {
		ids = ptWf.frame(parentLabels)
	}
	return df.join(ids, { on: ["clonotypeKey"], how: "left" })
}

/**
 * The flat `liabilities.tsv` with the parent's readable clone id joined on,
 * before `xsv.importFile` turns its first column into an axis.
 *
 * The liability group keeps upstream's own clonotype axis, and upstream's
 * `pl7.app/label` for that axis lives in the result pool the block's table
 * cannot read (`model/src/index.ts`, `tableFromAccessorOutput`). So the
 * Parents page can name a parent only through a value column of this block's
 * own — the same column, from the same source, the variant group carries.
 */
_withParentIdOnLiabilities := func(liabilitiesFile, parentLabels) {
	ptWf := pt.workflow().mem("1GiB").cpu(1)
	df := _withParentCloneId(
		ptWf,
		ptWf.frame(liabilitiesFile, { xsvType: "tsv", inferSchema: false }),
		parentLabels)
	df.save("liabilities-with-id.tsv")
	return ptWf.run().getFile("liabilities-with-id.tsv")
}

/**
 * Everything the flat `variants.tsv` must gain before `xsv.importFile` turns
 * a column into an axis — this is the only stage where the values are plain
 * columns, and `xsv.exportFrame` can relabel a PColumn but never compute one.
 *
 *   variantCloneKey     sha256 of `<parentKey>#<designed sequence>`,
 *                       base64-alphanumeric, 120 bits — upstream's
 *                       clonotype-key recipe (`mixcr-export.tpl.tengo:64-68`),
 *                       and the group's only axis. The parent is an
 *                       ingredient because it is part of what the row IS: two
 *                       parents that differ only at the one liability being
 *                       fixed converge on the same designed sequence, and
 *                       hashing the sequence alone would collide their rows
 *                       on a single axis value
 *   variantCloneId      `C-XXXXX` derived from that key
 *   parentClonotypeKey  the parent's key, renamed from the flat `clonotypeKey`
 *   parentCloneId       the parent's own `C-XXXXX`, joined from upstream's
 *                       label column when it exists; derived from the parent
 *                       key as a fallback when the dataset carries no label
 *   variantId           `<parentClonotypeId>:vNN` — the vendor's synthesis id
 *
 * The synthesis CSV is built here too, off the same flat table: a PColumn's
 * `axesSpec` must match the physical axis set its data was partitioned with
 * at `xsv.importFile` time, so re-speccing the imported columns for export
 * crashes at read time
 * (080-fact-export-axesspec-must-match-physical-partition-count). The flat
 * table has no axes to get wrong.
 */
_withIdentityAndCsv := func(variantsFile, parentLabels, blockId) {
	ptWf := pt.workflow().mem("1GiB").cpu(1)
	rawDf := ptWf.frame(variantsFile, { xsvType: "tsv", inferSchema: false })

	df := rawDf.withColumns(
		pt.col("clonotypeKey").alias("parentClonotypeKey"),
		pt.concatStr([pt.col("clonotypeKey"), pt.col("variantKey")], { delimiter: ":" }).alias("variantId"),
		pt.concatStr(
			[pt.col("clonotypeKey").fillNull(""), pt.col("variantSequence").fillNull("")],
			{ delimiter: "#" }).
			hash("sha256", "base64_alphanumeric", 120).
			alias("variantCloneKey"))
	df = _withDerivedCloneId(df, "variantCloneKey", "variantCloneId")

	df = _withParentCloneId(ptWf, df, parentLabels)
	df.save("variants-with-id.tsv")

	csvSelect := [pt.col("clonotypeKey").alias(specs.CSV_PARENT_HEADER)]
	for c in specs.csvColumnOrder(blockId) {
		csvSelect = append(csvSelect, pt.col(c.column).alias(c.csvHeader))
	}
	df.select(csvSelect...).save("synthesis.csv")

	result := ptWf.run()
	return {
		variantsWithId: result.getFile("variants-with-id.tsv"),
		synthesisCsv: result.getFile("synthesis.csv")
	}
}

wf.prepare(func(args) {
	// Anchor on the PDB column so upstream's per-residue confidence
	// auto-discovers on the same clonotype axis. There is no subset filter
	// to resolve here — an optional Lead Selection subset is a second,
	// independent column reference, resolved only when the user picked one.
	bb := wf.createPBundleBuilder()
	bb.ignoreMissingDomains()
	bb.addAnchor("pdb", args.primaryRef.column)
	bb.addMulti(
		{
			axes: [{ anchor: "pdb", idx: 0 }],
			name: "pl7.app/structure/confidence/perResidue"
		},
		"perResidueConfidence")
	// The parent's readable clone id, on the same clonotype axis. It is a
	// value this block cannot compute: the `-N` collision suffix is ranked
	// over the producing block's whole clonotype set, not over our subset.
	bb.addMulti(
		{
			axes: [{ anchor: "pdb", idx: 0 }],
			name: "pl7.app/label"
		},
		"parentLabel")

	prepared := {
		resolvedPdb: wf.resolve(args.primaryRef.column, { errIfMissing: true }),
		columns: bb.build()
	}
	if !is_undefined(args.subsetRef) {
		prepared.resolvedSubset = wf.resolve(args.subsetRef, { errIfMissing: true })
	}
	return prepared
})

wf.body(func(args) {
	blockId := wf.blockId().getDataAsJson()

	pdbCol := args.resolvedPdb
	pdbAxes := pdbCol.spec.axesSpec
	if len(pdbAxes) != 1 {
		ll.panic("unsupported PDB column axes count: expected 1 (the clonotype key), got %d", len(pdbAxes))
	}
	clonotypeAxis := pdbAxes[0]

	// Each ResourceMap key is a JSON-encoded [clonotypeKey] array; each value
	// is a Blob ref to a PDB file. One sorted pass builds the roster every
	// step shares and the path -> blob map `pdbs` restages into each exec —
	// sorted keys keep every step's input canonical so the pure step dedups.
	inputsMap := pdbCol.data.inputs()
	roster := []
	pdbs := {}
	for keyJson in maps.getKeys(inputsMap) {
		clonotypeKey := json.decode(keyJson)[0]
		bareName := clonotypeKey + ".pdb"
		pdbs["pdbs/" + bareName] = inputsMap[keyJson].getValue()
		roster = append(roster, { clonotypeKey: clonotypeKey, filename: bareName })
	}

	// The shared liability taxonomy, read once per run and handed to steps
	// 1 and 3 — the two that scan against it.
	definitionsResult := exec.builder().
		software(definitionsSw).
		mem("1GiB").
		cpu(1).
		printErrStreamToStdout().
		arg("definitions.json").
		saveFile("definitions.json").
		run()
	definitions := definitionsResult.getFile("definitions.json")

	liabilities := ScanLiabilities(roster, pdbs, definitions, args, args.columns, args.resolvedSubset)
	tolerance := _readTolerance(
		roster, pdbs, liabilities.output("residues"), liabilities.output("triaged"), args)
	variants := _buildVariants(
		roster,
		liabilities.output("triaged"),
		tolerance.output("tolerance"),
		liabilities.output("residues"),
		definitions,
		blockId,
		args)

	// The parent's label as a two-column frame `pt` can join on, with both
	// headers spelled here rather than deduced — `buildForPT` hands the
	// schema straight to `pt.frame`.
	parentLabels := undefined
	parentLabelCols := args.columns.getColumns("parentLabel")
	if !is_undefined(parentLabelCols) && len(parentLabelCols) > 0 {
		labelTsv := pframes.tsvFileBuilder()
		labelTsv.setAxisHeader(clonotypeAxis.name, "clonotypeKey")
		labelTsv.add(parentLabelCols[0], { header: "parentCloneId" })
		labelTsv.mem("1GiB")
		labelTsv.cpu(1)
		parentLabels = labelTsv.buildForPT()
	}

	// The variant group is keyed on the variant's own clonotype key; the
	// liability group stays keyed on the upstream parent axis, so a
	// downstream block auto-joins its rows exactly as it would on the PDB
	// column itself.
	variantsBuilt := _withIdentityAndCsv(variants.output("variants"), parentLabels, blockId)
	variantsXsv := xsv.importFile(
		variantsBuilt.variantsWithId, "tsv",
		specs.buildVariantsXsvSettings(blockId),
		{ splitDataAndSpec: true })
	liabilitiesXsv := xsv.importFile(
		_withParentIdOnLiabilities(liabilities.output("liabilities"), parentLabels), "tsv",
		specs.buildLiabilitiesXsvSettings(blockId, clonotypeAxis),
		{ splitDataAndSpec: true })

	// Stamp every emitted column with the trace chain derived from the
	// upstream PDB column so downstream consumers see the full lineage.
	trace := pSpec.makeTrace(pdbCol.spec, {
		type: "milaboratories.antibody-variant-designer",
		id: blockId,
		importance: 20,
		label: "Antibody Variant Designer"
	})

	variantsPfBuilder := pframes.pFrameBuilder()
	for k, v in variantsXsv {
		variantsPfBuilder.add(k, trace.inject(v.spec), v.data)
	}
	variantsPf := variantsPfBuilder.build()

	liabilitiesPfBuilder := pframes.pFrameBuilder()
	for k, v in liabilitiesXsv {
		liabilitiesPfBuilder.add(k, trace.inject(v.spec), v.data)
	}
	liabilitiesPf := liabilitiesPfBuilder.build()

	// The synthesis CSV: `A-0018`'s fixed column set, already built off the
	// flat table in `_withVariantIdAndCsv` — see its docstring for why.
	synthesisCsv := variantsBuilt.synthesisCsv

	return {
		outputs: {
			liabilitiesSkip: liabilities.output("skipContent"),
			toleranceSkip: tolerance.output("skipContent"),
			variantsSkip: variants.output("skipContent"),
			variantsData: pframes.exportFrame(variantsPf),
			liabilitiesData: pframes.exportFrame(liabilitiesPf),
			synthesisCsv: file.exportFile(synthesisCsv),
			variants: variantsPf,
			liabilities: liabilitiesPf
		},
		exports: {}
	}
})
