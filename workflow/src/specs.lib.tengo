ll := import("@platforma-sdk/workflow-tengo:ll")
maps := import("@platforma-sdk/workflow-tengo:maps")

// **A group's column list IS its table order, so the position stamps the
// priority.** No row writes a number of its own: a number beside a list that
// already fixes the order is a second copy of it, free to disagree. The grid
// draws a higher priority first, so the first row takes the highest number and
// each next row one step less.
ORDER_PRIORITY_STEP := 1000

_stampOrderPriority := func(columns) {
	for i, c in columns {
		c.spec.annotations["pl7.app/table/orderPriority"] =
			string((len(columns) - i) * ORDER_PRIORITY_STEP)
	}
	return columns
}

// ──────────── The Variants page's columns — one row per designed variant ────────────
//
// A row is `{column, csvHeader?, spec}`. `column` is not part of the spec: it
// is the header `variant_store.TSV_COLUMNS` writes, and it is what the importer
// reads the values from, so the row starts at the file and ends at the emitted
// column. `csvHeader` names the header the vendor's contract fixes — a
// spelling independent of both the PColumn name and the table's label.
//
// One row is `{column, csvHeader, csvOnly: true}` with no spec at all: the
// vendor's form still wants it, no table does.
//
// **This list fixes two orders at once.** Top to bottom it is the table's
// column order, which `_stampOrderPriority` turns into each column's priority.
// The rows that declare a `csvHeader`, read in the same order, are the vendor's
// whole set, `humannessScore` included. `variantId` leads that set; it carries no
// spec, only `csvOnly: true`, so `main.tpl.tengo` builds the value and no table
// shows it. Neither order is a number a row carries; both are this one list's
// position.
//
// This is the one list two readers share — `buildVariantsSettings` below and
// `csvColumnOrder` at the end of the file — so it is a named list rather than a
// literal inside either of them.

variantColumns := func(blockId) {
	return [
		{
			column: "variantId",
			csvHeader: "variantId",
			// The vendor's row, and nothing else: `csvOnly` keeps it out of the
			// PFrame, so no table ever shows it. `main.tpl.tengo` builds it on
			// the flat table as `<parentClonotypeId>:<variantKey>`, which is
			// where the CSV reads it from.
			csvOnly: true
		},
		// ── The row's identity, at the front of the table ──
		//
		// None declares a `csvHeader`, so the vendor's set steps over all three
		// and stays exactly what its contract fixes.
		//
		// The variant's own id leads whatever priority it carries, because it is
		// spelled `pl7.app/label` and the grid sorts every axis and every label
		// column ahead of the value columns
		// (`PlAgDataTable/sources/table-source-v2.ts:489-502`). The parent's id
		// follows it as the highest-priority value column, and the parent's key
		// third.
		{
			column: "variantClonotypeId",
			// The `C-XXXXX` short id, derived from `variantClonotypeKey` by
			// upstream's own recipe in `main.tpl.tengo`. Named `pl7.app/label`
			// rather than a private name so that it labels this group's axis.
			spec: {
				name: "pl7.app/label",
				valueType: "String",
				contextDomain: { "pl7.app/blockId": blockId },
				annotations: {
					"pl7.app/label": "Variant Clone Id",
					"pl7.app/description": "`C-XXXXX`, derived from the variant clonotype key the way upstream derives a clonotype id — digits dropped, first five characters, uppercased, with a rank suffix when two keys share the prefix."
				}
			}
		},
		{
			column: "parentClonotypeId",
			// The parent in the spelling a human reads. Carried verbatim from the
			// parent's own `pl7.app/label` upstream, never re-derived: the `-2`
			// collision suffix is ranked over the producing block's whole clonotype
			// set, so deriving it here from a subset could print a different string
			// than the Parents page shows for the same clonotype.
			//
			// Visible, unlike the key below it: which parent a variant was designed
			// from is what a reader checks second, right after which variant the
			// row is.
			spec: {
				name: "pl7.app/antibodyVariantDesigner/parentClonotypeId",
				valueType: "String",
				contextDomain: { "pl7.app/blockId": blockId },
				annotations: {
					"pl7.app/label": "Parent Clonotype Id",
					"pl7.app/description": "The clonotype this variant was designed from, as upstream names it."
				}
			}
		},
		{
			column: "parentClonotypeKey",
			// The machine half of the same binding — the parent's content hash,
			// which is what a downstream join needs and what the synthesis CSV
			// carries as `parentClonotypeId`.
			spec: {
				name: "pl7.app/antibodyVariantDesigner/parentClonotypeKey",
				valueType: "String",
				contextDomain: { "pl7.app/blockId": blockId },
				annotations: {
					"pl7.app/label": "Parent clone key",
					"pl7.app/description": "The parent's clonotype key, as minted by the block that produced the structures dataset.",
					"pl7.app/table/fontFamily": "monospace",
					"pl7.app/table/visibility": "optional"
				}
			}
		},
		{
			column: "rank",
			csvHeader: "rank",
			spec: {
				name: "pl7.app/score",
				valueType: "Long",
				contextDomain: { "pl7.app/blockId": blockId },
				annotations: {
					"pl7.app/label": "Rank",
					"pl7.app/description": "Position across every surviving variant in the run, starting at 1. Comparable across parents — rank 1 is the top pick dataset-wide.",
					"pl7.app/isScore": "true",
					"pl7.app/score/rankingOrder": "increasing",
					// Hidden by default: `parentRank` is the table's default view —
					// most users compare candidates within one parent, not across
					// the whole run — so this one only shows once a user asks for
					// it, same as `parentClonotypeKey` below.
					"pl7.app/table/visibility": "optional"
				}
			}
		},
		{
			// No `csvHeader`: the vendor's contract fixes `rank` as the
			// dataset-wide ordinal, and this is a Variants-page-only view onto
			// the same underlying order, scoped back down to one parent
			// ([[088-decision-rank-becomes-a-global-ordinal-via-a-second-pass]]).
			column: "parentRank",
			spec: {
				name: "pl7.app/antibodyVariantDesigner/parentRank",
				valueType: "Long",
				contextDomain: { "pl7.app/blockId": blockId },
				annotations: {
					"pl7.app/label": "Rank per parent",
					"pl7.app/description": "Position within this parent's own surviving set, starting at 1. Not comparable across different parents — for that, see `rank`. Lower is better — rank 1 is the top pick for that parent.",
					"pl7.app/isScore": "true",
					"pl7.app/score/rankingOrder": "increasing"
				}
			}
		},
		{
			column: "variantSequence",
			csvHeader: "variantSequence",
			// A designed sequence is a sequence, but NOT a MiXCR one: the block
			// re-derives no gene hit and no region boundary, so it publishes the
			// producer-neutral `pl7.app/sequence` under a feature of its own
			// rather than claiming `pl7.app/vdj/sequence` / `VDJRegion`, which
			// routes a consumer into a VDJ branch this group cannot feed. The
			// complete-feature name rides in the label instead — the rule
			// `synthetic-repertoire-profiler` follows for the same reason
			// (`column-specs.lib.tengo:498-506`).
			//
			// The only column here with a `domain`, and those two keys are both
			// what a consumer matches on and what stops this joining to the
			// parent's own sequence. `isAnchor` makes this the column a dataset
			// selector finds the group by; the group has no abundance column to
			// anchor, because a designed molecule was never sequenced.
			spec: {
				name: "pl7.app/sequence",
				valueType: "String",
				domain: {
					"pl7.app/feature": "designed-variant",
					"pl7.app/alphabet": "aminoacid"
				},
				contextDomain: { "pl7.app/blockId": blockId },
				annotations: {
					"pl7.app/label": "Designed VDJRegion aa",
					"pl7.app/description": "The full designed V-domain sequence. Only the positions listed in \"Changed positions\" differ from the parent.",
					"pl7.app/isAnchor": "true",
					"pl7.app/isMainSequence": "true",
					"pl7.app/isAssemblingFeature": "true",
					"pl7.app/table/visibility": "hidden"
				}
			}
		},
		{
			column: "chain",
			csvHeader: "chain",
			// Derived once per antibody from the residue index's own
			// `chain_role`, never carried as a boundary field.
			spec: {
				name: "pl7.app/antibodyVariantDesigner/chain",
				valueType: "String",
				contextDomain: { "pl7.app/blockId": blockId },
				annotations: {
					"pl7.app/label": "Chain",
					"pl7.app/description": "Which chain(s) \"Variant sequence\" renders: H alone for a VHH, H,L for a paired Fv.",
					"pl7.app/isDiscreteFilter": "true"
				}
			}
		},
		{
			column: "changedPositions",
			csvHeader: "changedPositions",
			spec: {
				name: "pl7.app/liabilities/changedPositions",
				valueType: "String",
				contextDomain: { "pl7.app/blockId": blockId },
				annotations: {
					"pl7.app/label": "Changed positions",
					"pl7.app/description": "The edits versus the parent, one per position: <chain>:<wild-type><IMGT position><designed residue>, comma-separated."
				}
			}
		},
		{
			column: "objective",
			csvHeader: "objective",
			// The constant `liability` — the only objective this block designs
			// against. A column rather than a domain key, like `status`, because
			// the synthesis CSV must carry the word.
			spec: {
				name: "pl7.app/antibodyVariantDesigner/objective",
				valueType: "String",
				contextDomain: { "pl7.app/blockId": blockId },
				annotations: {
					"pl7.app/label": "Objective",
					"pl7.app/description": "Always 'liability' — the objective this variant was designed against.",
					"pl7.app/isDiscreteFilter": "true",
					"pl7.app/table/visibility": "hidden"
				}
			}
		},
		{
			column: "addressedTarget",
			csvHeader: "addressedTarget",
			spec: {
				name: "pl7.app/liabilities/addressedTarget",
				valueType: "String",
				contextDomain: { "pl7.app/blockId": blockId },
				annotations: {
					"pl7.app/label": "Addressed liability",
					"pl7.app/isDiscreteFilter": "true",
					"pl7.app/description": "The one liability this variant was designed to clear — one variant always targets exactly one liability."
				}
			}
		},
		{
			column: "structuralTolerance",
			csvHeader: "structuralTolerance",
			// AntiFold's perplexity, `2^H₂(p)` over `[1,20]` — entropy in bits,
			// a different base from the natural-log columns beside it in the
			// model's own frame. The scale is backend-specific, so a second
			// backend changes the metric annotation, not this name.
			spec: {
				name: "pl7.app/structure/tolerance",
				valueType: "Double",
				contextDomain: { "pl7.app/blockId": blockId },
				annotations: {
					"pl7.app/label": "Structural tolerance",
					"pl7.app/description": "AntiFold's fold-tolerance score at the edited position(s) — higher means the model finds the substitution more compatible with the fold. This is what the binding-risk band and the low-tolerance floor are computed from. Higher is better.",
					"pl7.app/format": ".2f",
					"pl7.app/structure/toleranceMetric": "antifoldPerplexityBits"
				}
			}
		},
		{
			column: "humannessScore",
			csvHeader: "humannessScore",
			spec: {
				name: "pl7.app/humannessScore",
				valueType: "Double",
				contextDomain: { "pl7.app/blockId": blockId },
				annotations: {
					"pl7.app/label": "Humanness score",
					"pl7.app/description": "This variant's own heavy chain on the humanness scale, measured for every variant whichever objective built it, so a liability fix can be read against the parent baseline beside it. OASis identity (human-oas): fraction of overlapping 9-mer peptides found in human OAS antibody repertoires, x100 (range 0-100; higher = more human). NOTE: this is a raw OASis IDENTITY at a fixed tier, NOT a calibrated OASis percentile — it is not directly comparable to a calibrated percentile published elsewhere. The tier is fixed at peptides present in more than 10% of human OAS subjects.",
					"pl7.app/format": ".2f",
					"pl7.app/isScore": "true",
					"pl7.app/score/rankingOrder": "decreasing",
					"pl7.app/score/method": "OASis identity (human-oas, fixed tier)"
				}
			}
		},
		{
			// No `csvHeader`: the vendor's set is the thirteen headers
			// `specs.test.tengo` pins, and this column is a reading aid on the
			// page rather than part of that contract.
			column: "parentHumannessScore",
			// The same value the Parents page shows, joined onto this row from
			// `humanness.tsv` so a reader compares the designed score against the
			// baseline without leaving the page. Both cells are filled in every run
			// mode, so a liabilities-only run reads its own rise or fall.
			//
			// NOT spelled `pl7.app/humannessScore`, the name the variant's own score
			// carries: on this axis a row IS a variant, so that name must mean the
			// variant's own value. A consumer joining on it would otherwise read the
			// parent's number for a designed sequence.
			spec: {
				name: "pl7.app/antibodyVariantDesigner/parentHumannessScore",
				valueType: "Double",
				contextDomain: { "pl7.app/blockId": blockId },
				annotations: {
					"pl7.app/label": "Parent humanness",
					"pl7.app/description": "The parent's own heavy chain on the humanness scale, before any edit — the baseline this variant had to beat. Measured the same way as \"Humanness score\" beside it, so the two subtract. Empty only when the chain could not be scored.",
					"pl7.app/format": ".2f"
				}
			}
		},
		{
			column: "worstConfidence",
			csvHeader: "worstConfidence",
			// Every member of the confidence family carries the metric
			// annotation, so a consumer can detect the scale.
			spec: {
				name: "pl7.app/structure/confidence/worstOverEdits",
				valueType: "Double",
				contextDomain: { "pl7.app/blockId": blockId },
				annotations: {
					"pl7.app/label": "Worst predicted error, Å",
					"pl7.app/description": "The worst (highest) predicted structural error across the edited residues, in Å. One badly-predicted residue invalidates the edit regardless of how confident the model is at its neighbours. Lower is better — a small Å value means the model is confident in that position's structure.",
					"pl7.app/format": ".2f",
					"pl7.app/structure/confidenceMetric": "predictedErrorAngstroms"
				}
			}
		},
		{
			column: "bindingRisk",
			csvHeader: "bindingRisk",
			// There is no paratope model and no ΔΔG prediction anywhere in this
			// block, which is why this is a band rather than a number.
			spec: {
				name: "pl7.app/vdj/bindingRisk",
				valueType: "String",
				contextDomain: { "pl7.app/blockId": blockId },
				annotations: {
					"pl7.app/label": "Binding risk",
					"pl7.app/description": "A band standing in for a binding-affinity prediction, which this block does not make: High for a CDR edit with poor fold tolerance or low prediction confidence, Low for a framework edit with neither problem, Medium otherwise.",
					"pl7.app/isScore": "true",
					"pl7.app/isDiscreteFilter": "true",
					"pl7.app/discreteValues": "[\"Low\",\"Medium\",\"High\"]",
					"pl7.app/score/rankingOrder": "decreasing",
					// Ranked decreasing, so the default cutoff keeps the two bands
					// a user can act on and hides the ones most likely to cost
					// binding.
					"pl7.app/score/defaultCutoff": "[\"Low\",\"Medium\"]"
				}
			}
		},
		{
			column: "lowConfidenceWarning",
			csvHeader: "lowConfidenceWarning",
			// Same name, grammar and meaning as the Parents page's column of
			// that name, on the other axis.
			spec: {
				name: "pl7.app/liabilities/lowConfidence",
				valueType: "String",
				contextDomain: { "pl7.app/blockId": blockId },
				annotations: {
					"pl7.app/label": "Low confidence",
					"pl7.app/description": "Yes when the edited position falls in a low-confidence region of the structure prediction. The variant still generates — this is a caveat on the prediction, not a rejection of the edit."
				}
			}
		},
		{
			column: "status",
			csvHeader: "status",
			// The constant `unvalidated-hypothesis`. A column rather than a
			// domain key, like `objective`, because the synthesis CSV must
			// carry the word.
			spec: {
				name: "pl7.app/antibodyVariantDesigner/status",
				valueType: "String",
				contextDomain: { "pl7.app/blockId": blockId },
				annotations: {
					"pl7.app/label": "Status",
					"pl7.app/description": "Always 'unvalidated-hypothesis'. No variant on this page has been tested; the block predicts nothing about binding.",
					"pl7.app/table/visibility": "hidden"
				}
			}
		},
		{
			column: "variantKey",
			// A value column because `variantId` — the vendor's
			// synthesis id — is built from it, and because it is the only cell
			// that states this variant's rank order within its parent.
			spec: {
				name: "pl7.app/antibodyVariantDesigner/variantKey",
				valueType: "String",
				contextDomain: { "pl7.app/blockId": blockId },
				annotations: {
					"pl7.app/label": "Variant ordinal",
					"pl7.app/description": "A per-parent ordinal — v01, v02, … in that parent's own selection order. Unlike `rank`, this stays scoped to the parent even though rank is now dataset-wide.",
					"pl7.app/table/visibility": "optional"
				}
			}
		}
	]
}

// The variant group's own axis, written once because two groups key on it —
// the value columns and the parent linker below.
_variantKeyAxis := func(blockId) {
	return {
		column: "variantClonotypeKey",
		// The registry's variant identity axis. A designed sequence is a
		// variant, and this is the name every block that already reads
		// variants selects on, so this group needs no new name to be
		// consumed. `main.tpl.tengo` computes the value; the
		// `pl7.app/label` column beside it carries the short id.
		//
		// NOT `pl7.app/vdj/clonotypeKey`: label discovery binds a label
		// column to an axis by axis name alone, so that name would bind the
		// PARENT's `pl7.app/label` onto this axis and draw an all-null
		// "Clone Id" beside our own.
		spec: {
			type: "String",
			name: "pl7.app/variantKey",
			// One name, several producers, told apart by one domain key —
			// a peptide run writes `pl7.app/peptide/extractionRunId`, an
			// amplicon run `pl7.app/repertoire/extractionRunId`, and a design
			// run writes this. It carries the block id because two runs over
			// one dataset hash the same designed sequences to the same
			// values: without it, the rows of two runs share an axis value
			// and join into one.
			domain: {
				"pl7.app/antibodyVariantDesigner/designRunId": blockId
			},
			annotations: {
				"pl7.app/label": "Variant key",
				"pl7.app/description": "sha256 of the parent clonotype key and the designed V-domain sequence, base64-alphanumeric, 120 bits — the recipe upstream hashes a clonotype with. The parent is an ingredient because two parents that differ only at the liability being fixed converge on one designed sequence, and hashing the sequence alone would collide their rows. Same parent and same designed sequence, same key, in every run.",
				"pl7.app/table/fontFamily": "monospace"
			}
		}
	}
}

/**
	* The PFrame `variants.tsv` becomes — the Variants page's group.
	*
	* One axis, the variant's own clonotype key, so the group has a clonotype's
	* shape: a hashed row key plus a `pl7.app/label` beside it. The parent is no
	* longer the row's identity — it rides along as the binding columns
	* `parentClonotypeKey` / `parentClonotypeId`.
	*
	* A `csvOnly` row is the one thing dropped on the way in: it holds a `csvHeader`
	* and no spec, so it keeps its place in the contract order while no PColumn
	* carries it. `id` is left off every entry, so it defaults to `column`.
	*/
buildVariantsSettings := func(blockId) {
	columns := []
	for d in variantColumns(blockId) {
		if is_undefined(d.csvOnly) {
			columns = append(columns, { column: d.column, spec: d.spec })
		}
	}
	columns = _stampOrderPriority(columns)

	return {
		axes: [_variantKeyAxis(blockId)],
		columns: columns,
		storageFormat: "Parquet"
	}
}

/**
	* The PFrame `variant-parent-link.tsv` becomes — the variant-to-parent edge,
	* one row per variant, value the sentinel `1`.
	*
	* Two axes and no fact of its own: the relation IS the axis pair, which is
	* what makes this a linker rather than a value column. A consumer anchored on
	* either identity finds it by `pl7.app/isLinkerColumn` and walks it to reach
	* the other side, so a parent-keyed column — upstream's own `pl7.app/label`,
	* this block's Parents-page verdict — joins onto a variant row without either
	* group repeating it.
	*
	* The `parentClonotypeKey` value column on the Variants page states the same
	* binding for a human to read. It joins nothing: a value column is a fact
	* about the row, and only an axis carries an identity a join can match on.
	*
	* @param blockId: string - this run's block id, which the variant axis's
	*                 domain carries
	* @param clonotypeAxisSpec: map - upstream's clonotype axis, verbatim. An
	*                 axis joins on name, type and domain, so a spelling of this
	*                 block's own would point the edge at nothing.
	*/
buildParentLinkSettings := func(blockId, clonotypeAxisSpec) {
	return {
		axes: [
			_variantKeyAxis(blockId),
			{
				column: "clonotypeKey",
				spec: clonotypeAxisSpec
			}
		],
		columns: [
			{
				column: "link",
				spec: {
					name: "pl7.app/antibodyVariantDesigner/parentLink",
					valueType: "Int",
					contextDomain: { "pl7.app/blockId": blockId },
					annotations: {
						"pl7.app/isLinkerColumn": "true",
						"pl7.app/label": "Variant to parent link",
						"pl7.app/description": "The edge from a designed variant to the clonotype it was designed from. Always 1 — the pair of axes is the whole content.",
						"pl7.app/table/visibility": "hidden"
					}
				}
			}
		],
		storageFormat: "Parquet",
		partitionKeyLength: 0
	}
}

/**
	* The PFrame `liabilities.tsv` becomes — the Parents page's group, one row
	* per parent, carrying a coarse verdict and a summary of every triaged
	* liability including the declined ones.
	*
	* One axis and two value columns.
	* [[082-decision-the-liabilities-group-drops-to-one-axis]] replaced this
	* group's earlier (parent, liability) row grain and its six value columns
	* with this shape — the same one-row-per-parent summary
	* `antibody-sequence-liabilities` already ships for its own liabilities. The
	* hidden axis and the `parentClonotypeId` column that wraps it are untouched
	* by that change; only the row grain and the value columns are new.
	*
	* Column names come from `pl7.app/liabilities/`, the segment the sibling
	* liability blocks already own, because these are liability columns whoever
	* computed them.
	*
	* @param blockId: string - this run's block id, the context domain every
	*                 emitted column carries
	* @param clonotypeAxisSpec: map - upstream's clonotype axis, taken from the
	*                 resolved PDB column in `main.tpl.tengo`. Passed in, never
	*                 written here: a row of this group IS one of upstream's
	*                 clonotypes, and an axis joins on name, type and domain, so a
	*                 spelling of our own would key the group to nothing.
	*/
buildParentsSettings := func(blockId, clonotypeAxisSpec) {
	return {
		axes: [
			{
				column: "clonotypeKey",
				// Upstream's axis, hidden from the table because the
				// `parentClonotypeId` column below shows the same parent in the
				// spelling a human reads. It stays in the data: it is the row key
				// and what a downstream block joins on. Only annotations change,
				// so the hidden axis still joins to upstream's.
				//
				// `deepMerge` returns a new map and never writes into the caller's:
				// the same spec is handed to the Variants page's parent binding in
				// `main.tpl.tengo`.
				spec: maps.deepMerge(clonotypeAxisSpec, {
					annotations: {
						"pl7.app/description": "The clonotype these liabilities were found on, keyed as the block that produced the structures dataset keys it. Hidden here because \"Clone Id\" names the same parent in the spelling a human reads.",
						"pl7.app/table/visibility": "hidden"
					}
				})
			}
		],
		columns: _stampOrderPriority([
			{
				column: "parentClonotypeId",
				// The parent in the spelling a human reads (`C-EWOQA`), joined onto
				// the flat table in `main.tpl.tengo` from upstream's own
				// `pl7.app/label` — the same value the Variants page's
				// `parentClonotypeId` carries. It stands in for the parent axis
				// hidden above.
				//
				// NOT spelled `pl7.app/label`: upstream already emits that name for
				// this axis, and the model-side table renderer cannot reach it
				// through the result pool (`spec-helpers.lib.tengo`), so this block
				// carries its own readable copy instead of a second, colliding
				// `pl7.app/label` producer.
				//
				// Ahead of Verdict and Summary: the row's parent is what a reader
				// looks for first.
				spec: {
					name: "pl7.app/antibodyVariantDesigner/parentClonotypeId",
					valueType: "String",
					contextDomain: { "pl7.app/blockId": blockId },
					annotations: {
						"pl7.app/label": "Parent Clonotype Id",
						"pl7.app/description": "The clonotype this variant was designed from, as upstream names it."
					}
				}
			},
			{
				column: "verdict",
				spec: {
					name: "pl7.app/liabilities/verdict",
					valueType: "String",
					contextDomain: { "pl7.app/blockId": blockId },
					annotations: {
						"pl7.app/label": "Liability verdict",
						"pl7.app/description": "Whether this parent carries any triaged liability at all — present or none — buried and declined ones included. Read Summary for what was found and why a declined one was declined.",
						"pl7.app/isDiscreteFilter": "true"
					}
				}
			},
			{
				column: "humannessVerdict",
				spec: {
					name: "pl7.app/humannessVerdict",
					valueType: "String",
					contextDomain: { "pl7.app/blockId": blockId },
					annotations: {
						"pl7.app/label": "Humanness Verdict",
						"pl7.app/description": "Whether humanization found any non-human framework position on this parent at all — present or none. Empty when the run did not include the humanization objective, which is not the same as none. Read Humanness Summary for what was found and what was decided at each position.",
						"pl7.app/isDiscreteFilter": "true"
					}
				}
			},
			{
				column: "summary",
				spec: {
					name: "pl7.app/liabilities/summary",
					valueType: "String",
					contextDomain: { "pl7.app/blockId": blockId },
					annotations: {
						"pl7.app/label": "Summary",
						// Read in the Parents page's side panel, not as a column: the
						// joined line is too long for a cell and reads as one item per
						// line there.
						"pl7.app/table/visibility": "optional",
						"pl7.app/description": "Every triaged liability on this parent, comma-joined as <liability type>@<chain><IMGT position> (<verdict>), with the fixability class named when the verdict is fixability-declined. \"None\" when the parent triaged clean."
					}
				}
			},
			{
				column: "humannessSummary",
				spec: {
					name: "pl7.app/humannessSummary",
					valueType: "String",
					contextDomain: { "pl7.app/blockId": blockId },
					annotations: {
						"pl7.app/label": "Humanness Summary",
						// Side panel, for the same reason as Summary above.
						"pl7.app/table/visibility": "optional",
						"pl7.app/description": "Every framework position humanization considered on this parent, comma-joined as <wild type>@<chain><IMGT position> (humanised|declined) — declined means no candidate at that position cleared the humanness gate. \"None\" when every framework position already read as human. Empty when the run did not include the humanization objective."
					}
				}
			},
			{
				column: "heavyHumannessScore",
				spec: {
					name: "pl7.app/humannessScore",
					valueType: "Double",
					domain: { "pl7.app/vdj/chain": "IGHeavy" },
					contextDomain: { "pl7.app/blockId": blockId },
					annotations: {
						"pl7.app/label": "Heavy humanness",
						"pl7.app/description": "This parent's own heavy chain scored on the humanness scale, before any edit — the baseline each of its variants had to beat. Raw identity at one fixed tier, not a calibrated percentile, so it is not comparable with a published figure. Measured in every run mode, unlike the two humanization columns beside it."
					}
				}
			},
			{
				// Reuses the Variants page's own PColumn name — same real-world
				// value, same name, the precedent `parentClonotypeId` above already
				// set on this page
				// ([[089-decision-parents-page-gets-an-addable-parent-key-column]]).
				// `spec-helpers.lib.tengo` aliases it off the flat `clonotypeKey`
				// column; the hidden axis above is untouched.
				column: "parentClonotypeKey",
				spec: {
					name: "pl7.app/antibodyVariantDesigner/parentClonotypeKey",
					valueType: "String",
					contextDomain: { "pl7.app/blockId": blockId },
					annotations: {
						"pl7.app/label": "Parent clone key",
						"pl7.app/description": "The parent's clonotype key, as minted by the block that produced the structures dataset.",
						"pl7.app/table/fontFamily": "monospace",
						"pl7.app/table/visibility": "optional"
					}
				}
			}
		]),
		storageFormat: "Parquet"
	}
}

/**
	* The synthesis CSV's flat column order: every variant column that declares a
	* `csvHeader`, in list order — `{column, csvHeader}` pairs,
	* naming the flat TSV column to read and the contract header to write it
	* under. The column set is a vendor contract, not a display choice.
	*
	* **Built from the flat table, not from the imported PFrame**, which has no
	* axes to re-spec: `spec-helpers.lib.tengo` selects straight off it with
	* `pt.col(column).alias(csvHeader)`, in this order, before the import ever
	* runs.
	*
	* @return [{column, csvHeader}] - in the CSV's own contract order.
	*/
csvColumnOrder := func(blockId) {
	// The declaring rows in list order ARE the contract order — the identity
	// rows sit between them and are stepped over, because the list orders the
	// table and the vendor's set is only the part of it the vendor asked for.
	// `specs.test.tengo` pins the exact thirteen headers, which is what stops the
	// set growing when a row gains a `csvHeader` it should not have.
	order := []
	for d in variantColumns(blockId) {
		if !is_undefined(d.csvHeader) {
			order = append(order, { column: d.column, csvHeader: d.csvHeader })
		}
	}
	return order
}

export ll.toStrict({
	buildVariantsSettings: buildVariantsSettings,
	buildParentLinkSettings: buildParentLinkSettings,
	buildParentsSettings: buildParentsSettings,
	csvColumnOrder: csvColumnOrder
})
